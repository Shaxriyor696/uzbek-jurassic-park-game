# ===== Server (maxfiy) — haqiqiy qiymatlar faqat .env da (repositoryga tushmaydi) yoki hosting «Secrets»da =====
# BotFather bergan token. Faqat serverda: Cloudflare Worker secret va GitHub Actions secret.
BOT_TOKEN=
# Telegram webhook so'rovlarini tekshirish uchun tasodifiy satr (masalan: openssl rand -hex 24)
WEBHOOK_SECRET=

# ===== Ochiq sozlamalar (maxfiy emas) =====
# O'yinning HTTPS manzili (GitHub Pages): https://<github-login>.github.io/<repository>/
WEB_APP_URL=
# Bot va saqlash serveri (Cloudflare Worker) manzili: https://ujp-bot.<cloudflare-subdomain>.workers.dev
API_PUBLIC_URL=

# ===== Frontend build (ochiq, brauzerga tushadi — maxfiy narsa yozmang) =====
# VITE_API_URL=$API_PUBLIC_URL  — bulutli saqlash manzili
# VITE_BASE=/<repository>/      — GitHub Pages ichki manzili
